# ============================================================
# FIREBASE REALTIME DATABASE — Konfigurasi Wajib untuk Online
# Salin nilai ini dari: Firebase Console > Project Settings
# Paste ke: Vercel Dashboard > Settings > Environment Variables
# ============================================================

VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=nama-project.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://nama-project-default-rtdb.asia-southeast1.firebasedatabase.app
VITE_FIREBASE_PROJECT_ID=nama-project
VITE_FIREBASE_STORAGE_BUCKET=nama-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abc123
