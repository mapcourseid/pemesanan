# ===================================================
# MAP COURSE GeoKKPR — Environment Variables
# ===================================================

# --- BACKEND (Railway) ---
PORT=3001
NODE_ENV=production
FRONTEND_URL=https://nama-app-anda.vercel.app

# Firebase Admin (opsional, untuk server-side sync)
FIREBASE_PROJECT_ID=
FIREBASE_DATABASE_URL=

# --- XENDIT PAYMENT GATEWAY ---
# Dapatkan dari: Xendit Dashboard > Settings > API Keys
XENDIT_SECRET_KEY=xnd_development_...
XENDIT_PUBLIC_KEY=xnd_public_development_...
XENDIT_WEBHOOK_TOKEN=...
