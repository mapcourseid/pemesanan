{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/payment/xendit/invoice",
        "function": {
          "functionId": "createXenditInvoiceFn",
          "region": "asia-southeast1"
        }
      },
      {
        "source": "/createXenditInvoiceFn",
        "function": {
          "functionId": "createXenditInvoiceFn",
          "region": "asia-southeast1"
        }
      },
      {
        "source": "/api/payment/xendit/webhook",
        "function": {
          "functionId": "xenditWebhook",
          "region": "asia-southeast1"
        }
      },
      {
        "source": "/xenditWebhook",
        "function": {
          "functionId": "xenditWebhook",
          "region": "asia-southeast1"
        }
      },
      {
        "source": "/api/upload",
        "function": {
          "functionId": "uploadFile",
          "region": "asia-southeast1"
        }
      },
      {
        "source": "/uploadFile",
        "function": {
          "functionId": "uploadFile",
          "region": "asia-southeast1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**/*.@(js|css|woff2|woff|ttf|eot|svg|png|jpg|jpeg|gif|ico|json)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  },
  "database": {
    "rules": "database.rules.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ]
}
