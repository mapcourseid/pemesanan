# ============================================================
# Firebase Cloud Functions Environment Variables
# ============================================================

# Dapatkan API Secret Key dari: Dashboard Xendit > Settings > API Keys
XENDIT_SECRET_KEY=xnd_development_your_key_here

# Token Callback Webhook dari: Dashboard Xendit > Settings > Callbacks
XENDIT_WEBHOOK_TOKEN=your_callback_token_here

# URL Website Frontend Anda di Firebase
FRONTEND_URL=https://pemesanan-688f7.web.app
